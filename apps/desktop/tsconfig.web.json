{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/**/*",
    "src/preload/global.d.ts",
    "src/preload/index.ts",
    "src/preload/tray.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@/*": [
        "../../packages/ui/src/*"
      ],
      "@canopy/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@canopy/shared/agent-stream": [
        "../../packages/shared/src/agent-stream/index.ts"
      ],
      "@canopy/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@canopy/ui/tray": [
        "../../packages/ui/src/components/tray/tray-panel.tsx"
      ]
    },
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
