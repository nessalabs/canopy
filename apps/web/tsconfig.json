{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "../../packages/ui/src/*"
      ],
      "@canopy/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@canopy/shared/agent-stream": [
        "../../packages/shared/src/agent-stream/index.ts"
      ],
      "@canopy/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@canopy/ui/lab/avatar": [
        "../../packages/ui/src/lab/avatar-lab.tsx"
      ]
    },
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
