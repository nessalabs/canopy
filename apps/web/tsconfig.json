{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "../../packages/ui/src/*"
      ],
      "@canopy/shared": [
        "../../packages/shared/src/index.ts"
